# Install as a site configuration AFTER replacing
# __FORGESIGHT_DOMAIN__ and provisioning valid TLS files.
#
# Assumes:
# /srv/forgesight/app/frontend/dist contains the production build.
# FastAPI is bound only to 127.0.0.1:8000.
# The limits file is loaded in nginx's HTTP context.

server {
    listen 80;
    server_name __FORGESIGHT_DOMAIN__;

    return 301 https://__FORGESIGHT_DOMAIN__$request_uri;
}

server {
    listen 443 ssl;
    server_name __FORGESIGHT_DOMAIN__;

    ssl_certificate
        /etc/letsencrypt/live/__FORGESIGHT_DOMAIN__/fullchain.pem;
    ssl_certificate_key
        /etc/letsencrypt/live/__FORGESIGHT_DOMAIN__/privkey.pem;

    server_tokens off;

    root /srv/forgesight/app/frontend/dist;
    index index.html;

    # Default for non-inspection routes.
    client_max_body_size 1m;
    client_body_timeout 15s;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy
        strict-origin-when-cross-origin always;
    add_header Permissions-Policy
        "camera=(self), microphone=()" always;

    # Public liveness is intentionally lightweight.
    location = /api/v1/health {
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_pass http://127.0.0.1:8000;
    }

    location = /api/v1/capabilities {
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_pass http://127.0.0.1:8000;
    }

    # Real readiness may initialize the model and all banks.
    # Only the server's loopback interface can call it.
    location = /api/v1/ready {
        return 404;
    }

    # This is the only public model-inference route.
    location = /api/v1/inspect {
        # Includes multipart overhead beyond the 8 MiB
        # application-level uploaded-file limit.
        client_max_body_size 9m;

        limit_req zone=forgesight_inspect burst=3 nodelay;
        limit_conn forgesight_per_ip 2;

        proxy_request_buffering on;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 120s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # No trailing slash: preserve /api/v1/inspect.
        proxy_pass http://127.0.0.1:8000;
    }

    # Do not expose undeclared API or diagnostic routes.
    location ^~ /api/ {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
